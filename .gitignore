# Secrets
.env
.env.*
!.env.example

# Prometheus scrape config contains a live Home Assistant long-lived token.
# Track prometheus/prometheus.yml.example instead.
prometheus/prometheus.yml

# Metric / log / state data
prometheus_data/
loki_data/
grafana_data/
alloy_data/

# Home Assistant runtime state (contains tokens, DB, logs)
homeassistant/config/.storage/
homeassistant/config/.cloud/
homeassistant/config/.cache/
homeassistant/config/.ha_run.lock
homeassistant/config/.HA_VERSION
homeassistant/config/deps/
homeassistant/config/tts/
homeassistant/config/home-assistant_v2.db*
homeassistant/config/*.log*
homeassistant/config/home-assistant.log*

# Frigate runtime data lives on the NAS mount, config only is tracked
frigate/*.db*

# Config backups
*.back
*.back2
*.bak
*.old
# Superseded compose backups
docker-compose.yaml.minix.copy
