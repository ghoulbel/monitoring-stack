# Copy to .env and fill in real values. Never commit .env.
GRAFANA_ADMIN_PASSWORD=change-me
FRIGATE_RTSP_PASSWORD=change-me
# Home Assistant long-lived access token, used as the Bearer credential
# in prometheus/prometheus.yml (see prometheus.yml.example).
HA_BEARER_TOKEN=change-me
HOST_IP=192.168.1.10
SYNOLOGY_IP=192.168.1.999
SNMP_COMMUNITY=public
TZ=Europe/Zurich