global:
  scrape_interval: 15s
  evaluation_interval: 15s

scrape_configs:
  - job_name: 'prometheus'
    static_configs:
      - targets: ['localhost:9090']

  - job_name: 'node'
    static_configs:
      - targets: ['node-exporter:9100']

  - job_name: 'cadvisor'
    static_configs:
      - targets: ['cadvisor:8080']

  - job_name: 'homeassistant'
    metrics_path: '/api/prometheus'
    scheme: http
    authorization:
      type: Bearer
      credentials: 'REPLACE_WITH_HA_BEARER_TOKEN'
    static_configs:
      - targets: ['homeassistant:8123']
    relabel_configs:
      - source_labels: [__address__]
        target_label: instance
        replacement: home-assistant

  # Frigate serves its Prometheus metrics at /api/metrics, NOT /metrics.
  # /metrics returns the React SPA's index.html, so the old config made
  # Prometheus log "received unsupported Content-Type text/html" and this
  # target was permanently DOWN (verified broken for 48h+ via query_range).
  - job_name: 'frigate'
    metrics_path: '/api/metrics'
    static_configs:
      - targets: ['frigate:5000']

  - job_name: 'synology_snmp'
    metrics_path: /snmp
    params:
      module: [synology]
      auth: [public_v2]
    static_configs:
      - targets: ['192.168.1.198']
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: snmp-exporter:9116

  # GPU metrics. This job replaces the old "amd_gpu" job, which scraped
  # amd-metrics-exporter:9200 -- a container that has never existed in this
  # stack, so the target had been permanently DOWN. The host's real GPU is the
  # NVIDIA RTX 4060 Laptop GPU, exported by the dcgm-exporter service. The AMD
  # Raphael is only the CPU iGPU and node-exporter's hwmon collector already
  # covers it as node_hwmon_*.
  - job_name: 'nvidia_gpu'
    scrape_interval: 10s               # more frequent for GPU metrics
    static_configs:
      - targets: ['dcgm-exporter:9400']
    relabel_configs:
      - source_labels: [__address__]
        target_label: instance
        replacement: nvidia-gpu

  - job_name: 'alloy'
    static_configs:
      - targets: ['alloy:12345']

# Optional: remote_write / alerting rules / etc. can be added later
